# يمنع تنزيل قالب التطبيق مباشرة من المتصفح.
# app.html يُقدَّم عبر PHP فقط بعد التحقق من الجلسة والصلاحية،
# وتنزيله مباشرة كان يكشف منطق النظام وثوابته لأي زائر بلا حساب.

# Apache 2.4
<IfModule mod_authz_core.c>
    Require all denied
</IfModule>

# Apache 2.2
<IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
</IfModule>
